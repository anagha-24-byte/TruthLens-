# GEMINI_API_KEY: Required for server-side Gemini forensic reasoning & transcription.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Configurable Gemini models for TruthLens AI (primary + comma-separated fallbacks)
GEMINI_PRIMARY_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODELS="gemini-4-hydrogen,gemini-3.1-flash-lite"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
